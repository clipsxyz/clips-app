# Frontend Environment Variables

## API Configuration
# Laravel Backend (default)
VITE_API_URL=http://localhost:8000/api
# Enable/disable Laravel API (set to 'false' to use mock data)
VITE_USE_LARAVEL_API=true

## Google Maps API
# Same key as laravel-backend GOOGLE_MAPS_API_KEY (run: npm run sync:env)
VITE_GOOGLE_MAPS_API_KEY=

## App Configuration
VITE_APP_NAME=Gazetteer
VITE_APP_VERSION=1.0.0

## Feature Flags
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_PWA=true

## Development
VITE_DEV_MODE=true

## Firebase Configuration (for Push Notifications)
# Run: npm run sync:env (reads android/ios Firebase + firebase-web.local.json for VAPID)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=gazetter26.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gazetter26
VITE_FIREBASE_STORAGE_BUCKET=gazetter26.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=257169934666
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=