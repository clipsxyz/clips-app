{
  "name": "gazetteer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:ios": "react-native run-ios",
    "dev:android": "react-native run-android",
    "android:adb-reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8000 tcp:8000 && adb reverse tcp:8080 tcp:8080",
    "dev:clean": "npm run clean:cache && vite",
    "build": "vite build",
    "build:web": "vite build",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "fetch-music": "node scripts/fetchRoyaltyFreeMusic.js",
    "setup:ffmpeg-native": "node scripts/setup-ffmpeg-native.mjs",
    "sync:env": "node scripts/sync-firebase-env.mjs",
    "check:secrets": "node scripts/check-no-secrets-staged.mjs",
    "prepare": "node scripts/install-git-hooks.mjs && node scripts/patch-react-native-fragment-props.mjs && node scripts/patch-image-picker-options.mjs && node scripts/patch-crop-picker-gallery.mjs",
    "patch:rn-fragment": "node scripts/patch-react-native-fragment-props.mjs",
    "clean:cache": "node -e \"const fs = require('fs'); const path = require('path'); const rimraf = (dir) => { try { fs.rmSync(dir, { recursive: true, force: true }); console.log('Cleared:', dir); } catch(e) {} }; rimraf(path.join(process.cwd(), 'node_modules/.vite')); rimraf(path.join(process.cwd(), 'dist')); console.log('Cache cleared!');\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/messaging": "^24.0.0",
    "@react-native-picker/picker": "^2.9.0",
    "@react-navigation/bottom-tabs": "^7.8.2",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.6.2",
    "@sentry/react": "^10.36.0",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@types/qrcode": "^1.5.6",
    "expo": "^57.0.14",
    "ffmpeg-kit-react-native-alt": "^6.0.6",
    "firebase": "^10.7.1",
    "framer-motion": "^12.23.24",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.1",
    "laravel-echo": "^2.4.0",
    "nativewind": "^4.2.1",
    "pusher-js": "^8.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^4.12.0",
    "react-native": "^0.85.3",
    "react-native-audio-recorder-player": "^4.5.0",
    "react-native-contacts": "^8.0.10",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-image-crop-picker": "^0.40.0",
    "react-native-image-picker": "^7.1.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-nitro-modules": "^0.29.8",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.1",
    "react-native-svg": "^15.15.5",
    "react-native-vector-icons": "^10.3.0",
    "react-native-video": "^6.19.2",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "^0.21.2",
    "react-native-webrtc": "^124.0.7",
    "react-native-worklets": "^0.8.3",
    "react-router-dom": "^6.8.1",
    "socket.io-client": "^4.8.1",
    "sweetalert2": "^11.26.3",
    "tone": "^15.1.22",
    "web-vitals": "^3.5.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-android": "^20.0.0",
    "@react-native/babel-preset": "^0.85.3",
    "@react-native/jest-preset": "^0.85.3",
    "@react-native/metro-config": "^0.85.3",
    "@size-limit/preset-app": "^12.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-basic-ssl": "^2.1.3",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "esbuild": "^0.27.2",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jiti": "^2.7.0",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.24",
    "size-limit": "^10.0.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.2",
    "vite": "^7.3.1",
    "vitest": "^0.34.0"
  },
  "size-limit": [
    {
      "name": "entry js",
      "path": "dist/assets/*-legacy*.js",
      "limit": "150 KB"
    },
    {
      "name": "entry js",
      "path": "dist/assets/*-[a-f0-9].js",
      "limit": "150 KB"
    },
    {
      "name": "async chunks",
      "path": "dist/assets/chunk-*.js",
      "limit": "200 KB"
    },
    {
      "name": "css",
      "path": "dist/assets/*.css",
      "limit": "30 KB"
    }
  ]
}
