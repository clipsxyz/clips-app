# Dependencies
node_modules/
vendor/

# Env / secrets
env.zip
src.zip
.env
.env.*
!.env.example
!.env.*.example
laravel-backend/.env
laravel-backend/.env.*
!laravel-backend/.env.example
firebase-web.local.json
# Firebase Admin / Google service-account JSON (never commit)
**/firebase-auth.json
laravel-backend/storage/app/firebase-auth.json
**/*firebase*adminsdk*.json
**/*service-account*.json
**/serviceAccount*.json
**/credentials.json
!**/*.example
!**/*.example.json
# Native Firebase config (API keys) — use sync-firebase-env.mjs from local copies
android/app/google-services.json
ios/GoogleService-Info.plist
ios/**/GoogleService-Info.plist
# Generated from public/firebase-messaging-sw.template.js (vite-plugin-firebase-sw)
public/firebase-messaging-sw.js

# Build / bundler output
dist/
build/
.expo/
.turbo/
.cache/
*.tsbuildinfo

# PHPUnit coverage (Laravel backend)
laravel-backend/coverage/
laravel-backend/coverage.xml
# Laravel local env and runtime
laravel-backend/.env
laravel-backend/database/database.sqlite
laravel-backend/vendor/
# Ignore all Laravel runtime storage (uploads, logs, compiled views, cache).
# Intentionally tracked assets under storage/ remain tracked if already in the index.
laravel-backend/storage/**
# Keep a non-secret template for local setup docs (real firebase-auth.json stays ignored).
!laravel-backend/storage/app/
!laravel-backend/storage/app/firebase-auth.json.example
# Explicit secret paths (defense-in-depth if storage/ rules change)
laravel-backend/storage/app/firebase-auth.json

# Local debug/release APKs (build artifacts)
*.apk
app-debug.apk

# Android Studio / Gradle
android/local.properties
android/.gradle/
android/.kotlin/
android/.idea/
android/build/
android/app/build/
android/app/.cxx/
**/build/

# iOS / CocoaPods / Xcode
ios/Pods/
ios/build/
ios/DerivedData/
ios/.xcode.env.local
*.xcuserstate
xcuserdata/

# FFmpeg Kit vendored binaries (npm run setup:ffmpeg-native)
android/ffmpeg-kit-local-maven/
ios/FFmpegKitVendor/
.tmp-ffmpeg-setup/

# macOS
.DS_Store

# Local SQLite databases
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Local Laravel/PHP script and ini overrides
laravel-backend/serve.sh
laravel-backend/.user.ini
laravel-backend/php-dev.d/
laravel-backend/.phpunit.cache/
laravel-backend/public/storage
