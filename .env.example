# Copy this file to `.env` and fill in real values. Do not commit `.env`.
# Vite exposes VITE_* and EXPO_PUBLIC_* (see vite.config envPrefix).

# --- API ---
# Laravel API base URL (include /api if your backend mounts there).
# Physical Android on Wi‑Fi: use the Mac LAN IP (not localhost — the phone cannot
# reach the Mac's loopback). Example: http://192.168.1.9:8000/api
# Laravel must listen on 0.0.0.0:8000 (php artisan serve --host=0.0.0.0).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.9:8000/api
EXPO_PUBLIC_API_URL=http://192.168.1.9:8000/api
REACT_NATIVE_API_URL=http://192.168.1.9:8000/api
# true = keep local mock data; false = use Laravel (EXPO_PUBLIC_API_BASE_URL)
EXPO_PUBLIC_USE_MOCK=false
# Legacy aliases (still supported by the API client)
VITE_API_URL=http://192.168.1.9:8000/api
# Set to false when Laravel is not running (mock feed, Sarah/Bob demo MP4s, no API timeouts).
# When true and the backend is down, the app auto-falls back to mock after the first failed request.
VITE_USE_LARAVEL_API=true

# --- Maps (sync from laravel-backend/.env: npm run sync:env) ---
# Backend source of truth: Places Autocomplete + Geocoding (server-side via Laravel).
# Enable Places API + Geocoding API on the Google Cloud key (Places API New optional).
# Passport region/city pickers use /api/search/places — keep EXPO_PUBLIC_ in sync for RN.
VITE_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Also set in laravel-backend/.env:
# GOOGLE_MAPS_API_KEY=

# --- App ---
VITE_APP_NAME=Gazetteer
VITE_APP_VERSION=1.0.0

# --- Feature flags ---
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_PWA=true

# --- Development ---
# When true, some flows skip backend (e.g. gallery preview)
VITE_DEV_MODE=false
# Facebook Login App ID (required for Find Facebook Friends on web)
VITE_FACEBOOK_APP_ID=
# Opt-in verbose DM/group cursor pagination logs in web dev.
VITE_DEBUG_MESSAGE_PAGING=false
# Opt-in verbose profile grid pagination logs in web dev.
VITE_DEBUG_PROFILE_GRID_PAGING=false

# --- Realtime (Laravel Reverb) ---
# Match laravel-backend/.env REVERB_* values. Phone uses the API host (LAN IP) + this port.
EXPO_PUBLIC_REVERB_APP_KEY=
EXPO_PUBLIC_REVERB_HOST=192.168.1.9
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${EXPO_PUBLIC_REVERB_APP_KEY}"
VITE_REVERB_HOST="${EXPO_PUBLIC_REVERB_HOST}"
VITE_REVERB_PORT="${EXPO_PUBLIC_REVERB_PORT}"
VITE_REVERB_SCHEME="${EXPO_PUBLIC_REVERB_SCHEME}"

# --- Realtime (optional Socket.IO, DMs only; Reverb is the source of truth) ---
# WebSocket URL for Socket.IO, if used
VITE_SOCKETIO_URL=

# --- Payments (optional) ---
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Error monitoring (optional) ---
VITE_SENTRY_DSN=
VITE_RELEASE_VERSION=

# --- Firebase / FCM (npm run sync:env; VAPID via firebase-web.local.json) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=gazetter26.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gazetter26
VITE_FIREBASE_STORAGE_BUCKET=gazetter26.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=257169934666
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
