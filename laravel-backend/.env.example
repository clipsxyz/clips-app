# Application
APP_NAME=Gazetteer
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Used for Storage::url() and absolute media links. Production example:
# APP_URL=https://api.your-domain.com
APP_URL=http://localhost:8000

# Frontend app URL used by invite social card redirects
FRONTEND_APP_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (sqlite for local; mysql/pgsql for production)
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=gazetteer
# DB_USERNAME=root
# DB_PASSWORD=

# Filesystems — public disk writes to storage/app/public and is served at /storage/*
# After deploy / clone: php artisan storage:link
FILESYSTEM_DISK=public

# Optional S3 / R2 for production media (set FILESYSTEM_DISK=s3 to use)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Query profiler (dev/testing by default)
# Set to true to force-enable outside local/testing.
QUERY_PROFILER_ENABLED=false

# Warning log thresholds (only used by QueryProfiler middleware)
QUERY_PROFILER_LOG_QUERY_COUNT_THRESHOLD=25
QUERY_PROFILER_LOG_SLOWEST_MS_THRESHOLD=50
QUERY_PROFILER_LOG_TOTAL_MS_THRESHOLD=120
QUERY_PROFILER_LOG_REQUEST_MS_THRESHOLD=500

# Google Places + Geocoding API key (required for live global locations).
# Used by: /api/search/places, /api/locations/search, /api/locations/geocode, /api/locations/details
# Enable Places API (Place Autocomplete) + Geocoding API. Synced to root VITE_/EXPO_PUBLIC_GOOGLE_MAPS_API_KEY via npm run sync:env.
GOOGLE_MAPS_API_KEY=

# Firebase (FCM). Native uses google-services.json / GoogleService-Info.plist.
# Server push requires a service-account JSON (Firebase Console → Project settings → Service accounts).
FIREBASE_PROJECT_ID=gazetter26
# Path relative to laravel-backend/ (copy storage/app/firebase-auth.json.example → firebase-auth.json)
FIREBASE_CREDENTIALS=storage/app/firebase-auth.json

# Twilio OTP delivery (optional). Used by /api/auth/phone/send-code.
# OTP_CHANNEL supports: whatsapp, sms
# For WhatsApp set TWILIO_WHATSAPP_FROM like: whatsapp:+14155238886
# For SMS set TWILIO_FROM like: +1234567890
OTP_CHANNEL=whatsapp
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# Facebook social graph integration (Find Facebook Friends)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v20.0

# Mail — local dev: log writes to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@gazetteer.app
MAIL_FROM_NAME=Gazetteer

# Production (pick one provider; then set APP_ENV=production on server)
# SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.postmarkapp.com
# MAIL_PORT=587
# MAIL_USERNAME=your-postmark-server-token
# MAIL_PASSWORD=your-postmark-server-token
# MAIL_ENCRYPTION=tls
# Postmark (install symfony/postmark-mailer if needed):
# MAIL_MAILER=postmark
# POSTMARK_TOKEN=your-token
# Resend (MAIL_URL):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_xxxxxxxx

# Inactive digest emails (Instagram-style "what you missed")
ENGAGEMENT_INACTIVE_DAYS=3
ENGAGEMENT_DIGEST_COOLDOWN_HOURS=48
ENGAGEMENT_DIGEST_MAX_POSTS=5

# Stripe (optional)
# STRIPE_KEY=
# STRIPE_SECRET=
